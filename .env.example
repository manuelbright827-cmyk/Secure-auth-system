PORT=3000
NODE_ENV=development

# Keep this secret stable after users link authenticators; it also encrypts TOTP secrets in the database.
SESSION_SECRET=replace_with_a_long_random_secret
PASSWORD_PEPPER=replace_with_a_long_random_secret

# Password reset code delivery.
# Use "console" for local development to print reset codes in the server log.
# Use "smtp" with the SMTP settings below for real email delivery.
EMAIL_DELIVERY=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
APP_BASE_URL=http://localhost:3000

DATABASE_PATH=./backend/database/auth.db

# Automatic SQLite backups run on startup and then every 24 hours; older backups are pruned.
BACKUP_DIRECTORY=backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# Google Drive OAuth client JSON (keep the file private and never commit it).
GOOGLE_DRIVE_CLIENT_SECRET_FILE=client_secret_your-project.apps.googleusercontent.com.json
GOOGLE_DRIVE_TOKEN_FILE=secrets/google-drive-token.json
GOOGLE_DRIVE_FOLDER_ID=paste_the_folder_id_from_the_drive_folder_url

# Generate a random 32-byte key (64 hex characters) and keep it separate from Drive.
# Cloud backups are AES-256-GCM encrypted; losing this key means backups cannot be restored.
BACKUP_ENCRYPTION_KEY=replace_with_64_random_hex_characters
